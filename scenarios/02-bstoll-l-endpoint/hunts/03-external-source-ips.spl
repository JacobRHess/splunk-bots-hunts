index=* sourcetype=WinEventLog:Security host=BSTOLL-L EventCode=4624 earliest=-10y
| rex max_match=1 "Source Network Address:\s+(?<bh_sna>\S+)"
| eval bh_sna = coalesce(bh_sna, "-")
| eval is_external = if(
    bh_sna != "-"
        AND NOT cidrmatch("127.0.0.0/8", bh_sna)
        AND NOT cidrmatch("10.0.0.0/8", bh_sna)
        AND NOT cidrmatch("172.16.0.0/12", bh_sna)
        AND NOT cidrmatch("192.168.0.0/16", bh_sna),
    1, 0)
| stats count as total, sum(is_external) as external_count
| eval external_count = coalesce(external_count, 0)
| fields external_count
